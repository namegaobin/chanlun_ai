# 缠论 AI 分析系统 - 环境变量配置示例
# ==========================================
# 使用方法:
# 1. 复制本文件为 .env
# 2. 填入你的 API Key
# 3. 根据需要调整配置
# ==========================================

# AI 服务提供商配置
# 可选值: siliconflow / openrouter / deepseek / anthropic
AI_PROVIDER=deepseek

# AI 模型配置
# 硅硅流动模型示例: Pro/deepseek-ai/DeepSeek-V3.2
# OpenRouter模型示例: anthropic/claude-3.5-sonnet
# DeepSeek模型示例: deepseek-chat / deepseek-reasoner
# 腾讯云DeepSeek: ms-cnhh7fpx
AI_MODEL=deepseek-chat

# API Key 配置
# 硅硅流动 API Key
SILICONFLOW_API_KEY=YOUR_API_KEY_HERE

# OpenRouter API Key (如果使用 OpenRouter)
# OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY

# DeepSeek API Key (官方)
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY

# 腾讯云 DeepSeek API Key
DEEPSEEK_API_KEY=YOUR_TENCENT_DEEPSEEK_KEY

# 腾讯云 DeepSeek Base URL (可选，如果使用腾讯云托管)
# DEEPSEEK_BASE_URL=https://your-tencent-cloud-endpoint/v1

# Anthropic API Key (如果使用 Claude 官方)
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY

# AI 调用参数
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=32768

# K 线数据配置
DEFAULT_KLINE_LIMIT=200

# 代理配置（访问 Binance API 需要）
# HTTP_PROXY=http://127.0.0.1:11090
# HTTPS_PROXY=http://127.0.0.1:11090
